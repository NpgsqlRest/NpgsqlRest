<Project>
  <!--
    Single source of truth for the product version (core library + NpgsqlRestClient + npm package + release tag).
    Edit version.txt in the repo root - everything else derives from it (see RELEASING.md).
    Plugins under plugins/ version independently and do NOT use this property.
  -->
  <PropertyGroup>
    <NpgsqlRestProductVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</NpgsqlRestProductVersion>
  </PropertyGroup>

  <!--
    No project in this repo uses the ASP.NET Core static web assets pipeline (no wwwroot, no MapStaticAssets);
    the Web SDK is used only for the ASP.NET Core shared framework. Since .NET SDK 11, every Web SDK project
    in a Debug build defines Blazor Hot Reload browser-tools JS modules as static web assets, and a Web SDK
    project referencing another Web SDK project (every plugin -> NpgsqlRest) fails with
    "The following scoped css bundles do not have matching endpoints:
    _framework/Microsoft.NET.Sdk.BlazorWeb.HotReload#[.{fingerprint}]!.lib.module.js".
    Disabling the unused pipeline avoids it (Release builds were never affected; runtime Hot Reload is unaffected).
  -->
  <PropertyGroup>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!--
    .NET 11 Runtime Async (<Features>$(Features);runtime-async=on</Features>) is NOT enabled by default.
    It can be turned on for the net11.0 builds with -p:NpgsqlRestRuntimeAsync=true (see Directory.Build.targets).
    Measured on .NET 11.0.0 (BenchmarkTests/Baselines/EndpointBenchmarks-4.0.0-perf.md):
    - With the original single ~3,400-line request handler: the NativeAOT client crashed on the first request
      (SIGBUS) and each suspension saved ~13.7 KB continuation frames (+7..12 KB per request).
    - With the handler split into a few large methods: AOT worked, but ~1 KB more per request. With Runtime Async
      the continuation of a method is sized for its largest suspension point, and every suspension pays for it.
    - With the request pipeline as small methods around one pooled request state (4.0.0): same CPU per request,
      latency and throughput as the classic build within measurement noise (JIT and AOT), ~0.3 KB more per request.
      AOT works (smoke test with real requests), the test suite passes.
    It stays off because it has no benefit yet: the request waits inside Npgsql, which is compiled classically,
    and each await that crosses that boundary allocates (RuntimeAsyncTask + continuation), while the classic build
    pools its state machines. Re-measure when Npgsql ships Runtime Async builds.
    Notes:
    - With runtime-async=on the compiler ignores [AsyncMethodBuilder(PoolingAsyncValueTaskMethodBuilder)]: those
      methods become Runtime Async methods like any other (they do NOT stay classic).
    - <UseRuntimeAsync>false</UseRuntimeAsync> is not implemented by SDK 11.0.100; to opt a project out, remove
      runtime-async=on from $(Features).
    - Only ever enable it together with the AOT smoke test that serves real requests (.github/scripts).
  -->
</Project>
